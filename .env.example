SITE_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# PostgreSQL in production; leave blank for local SQLite in data/regalis.sqlite
DATABASE_URL=
DATABASE_SSL=false
# PEM CA certificate from your database provider; literal \n or actual newlines accepted
DATABASE_CA_CERT=
SQLITE_PATH=./data/regalis.sqlite
DEMO_MODE=true
# Use S3-compatible storage in multi-instance production; otherwise persistent UPLOAD_DIR
UPLOAD_DIR=./public/uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Password recovery requires verified outgoing email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set only behind a trusted proxy that overwrites x-forwarded-for
TRUST_PROXY=false
